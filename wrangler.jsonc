{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mi-app-nextjs",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-03-01",
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}